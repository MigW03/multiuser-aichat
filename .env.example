# Copy to .env.local (gitignored). The old NEXT_PUBLIC_* names also work.

# --- Public: used by the web and desktop clients (safe to ship)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_URL=http://localhost:8787

# --- Server only: never expose these to a client
SUPABASE_SECRET_KEY=
# Encrypts users' API keys at rest (AES-256-GCM). Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
PORT=8787
# Comma-separated origins allowed to call the server
ALLOWED_ORIGINS=http://localhost:5173,app://desktop
# The web app's public address. Invite links point here (https://, or http://localhost for development).
APP_URL=http://localhost:5173
# Set to 1 only behind a proxy that sets X-Forwarded-For (Fly.io does), so rate limits see the real client address.
TRUST_PROXY=
# Optional: emails invite links through Resend. Without these the invite dialog shows the link to copy and send yourself.
RESEND_API_KEY=
MAIL_FROM=
