# Copy to .env.local (gitignored). The old NEXT_PUBLIC_* names also work.

# --- Public: used by the web and desktop clients (safe to ship)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave unset for local dev (defaults to http://localhost:8787). Set it in the host's environment variables for a deploy,
# e.g. https://multiuser-chat-server.fly.dev
VITE_SERVER_URL=
# Desktop app only (optional): the website address, so "Copy link to chat" makes https links. Unset: multiuserchat:// links.
VITE_WEB_URL=

# --- Server only: never expose these to a client
SUPABASE_SECRET_KEY=
# Encrypts users' API keys at rest (AES-256-GCM). Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
PORT=8787
# Comma-separated origins allowed to call the server
ALLOWED_ORIGINS=http://localhost:5173,app://desktop
# The web app's public address. Invite links point here (https://, or http://localhost for development).
APP_URL=http://localhost:5173
# Optional: this server's own public address (https://, or http://localhost for development). It is the redirect address for
# OAuth sign-in to remote MCP servers; without it OAuth sign-in is off (servers with no sign-in or a header token still work).
SERVER_URL=
# Set to 1 only behind a proxy that sets X-Forwarded-For (Fly.io does), so rate limits see the real client address.
TRUST_PROXY=
# Optional: emails invite links through Resend. Without these the invite dialog shows the link to copy and send yourself.
RESEND_API_KEY=
MAIL_FROM=
# Optional: Cloudflare R2 (S3 API) for project designs (designs/<project>/...) and, later, shared file copies. Set all four
# or none. Without them the Designs tab answers "storage isn't set up" and the AI has no design tools. Use the same values
# as the deployed server (bucket nido-files); the server log says at start whether they are set.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
