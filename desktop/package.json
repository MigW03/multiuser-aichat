{
  "name": "@mc/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "npm run build:main && cross-env DESKTOP_DEV_URL=http://localhost:5173 electron .",
    "build": "npm run build:main",
    "start": "electron .",
    "build:web": "node scripts/build-web.mjs",
    "test": "tsx --test src/*.test.ts",
    "pack": "npm run build:main && npm run build:web && electron-builder --dir",
    "dist:mac": "npm run build:main && npm run build:web && electron-builder --mac dmg",
    "dist:win": "npm run build:main && npm run build:web && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "version": "0.1.0",
  "description": "Multiuser Chat desktop app",
  "author": "Miguel Weber",
  "build": {
    "appId": "com.multiuserchat.desktop",
    "productName": "Multiuser Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web-dist"
      }
    ],
    "protocols": [
      {
        "name": "Multiuser Chat",
        "schemes": [
          "multiuserchat"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
