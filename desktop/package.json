{
  "name": "@mc/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "npm run build:main && cross-env DESKTOP_DEV_URL=http://localhost:5173 electron .",
    "build": "npm run build:main",
    "start": "electron ."
  },
  "devDependencies": {
    "@mc/shared": "*",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2"
  }
}
