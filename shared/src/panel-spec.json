{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(children: (Card | Text | Stat | Table | BarChart | Checklist | Callout | Choice | Buttons | Form | Input | Select | SourceStat | SourceTable | SourceList | Check | Notes)[], direction?: \"column\" | \"row\")",
      "description": "The top-level container. Blocks go one under the other, or side by side with direction \"row\" (they wrap on narrow screens)."
    },
    "Card": {
      "signature": "Card(title: string, children: (Text | Stat | Table | BarChart | Checklist | Callout | Choice | Buttons | Form | Input | Select | SourceStat | SourceTable | SourceList | Check | Notes)[], subtitle?: string)",
      "description": "A titled box that groups related blocks, such as one option of several or one person's part."
    },
    "Text": {
      "signature": "Text(text: string, tone?: \"default\" | \"muted\")",
      "description": "A paragraph of text. Markdown inline formatting (bold, italics, code, links) works."
    },
    "Stat": {
      "signature": "Stat(label: string, value: string | number, note?: string)",
      "description": "One key number with its label, and an optional short note such as a change or a date."
    },
    "Table": {
      "signature": "Table(columns: string[], rows: (string | number)[][])",
      "description": "A table: column headers, then rows of cells in the same order."
    },
    "BarChart": {
      "signature": "BarChart(labels: string[], series: Series[], unit?: string)",
      "description": "Bars to compare numbers across labels. Several Series show side by side."
    },
    "Checklist": {
      "signature": "Checklist(items: Task[], title?: string)",
      "description": "A plan or list of next steps, each a Task."
    },
    "Callout": {
      "signature": "Callout(tone: \"info\" | \"success\" | \"warning\" | \"danger\", title: string, text?: string)",
      "description": "A highlighted note: a warning, a tip, a success or a risk."
    },
    "Choice": {
      "signature": "Choice(question: string, options: Option[])",
      "description": "A question with options to pick from, when the answer needs a decision from the people in the chat."
    },
    "Buttons": {
      "signature": "Buttons(buttons: Button[])",
      "description": "A row of buttons, such as follow-up suggestions."
    },
    "Form": {
      "signature": "Form(name: string, fields: (Input | Select)[], submitLabel?: string)",
      "description": "Questions for the reader to fill in. The submit button drafts a reply with the answers."
    },
    "Input": {
      "signature": "Input(name: string, label: string, value?: $binding<string | number>, placeholder?: string, type?: \"text\" | \"number\", multiline?: boolean)",
      "description": "A text or number field: in a Form (`name` is the field's key in the reply), or on its own bound to a $variable as `value` so other blocks can compute from it. A \"number\" field stores a number."
    },
    "Select": {
      "signature": "Select(name: string, label: string, options: string[], value?: $binding<string>)",
      "description": "A dropdown with the choices as plain text: in a Form, or on its own bound to a $variable as `value`."
    },
    "SourceStat": {
      "signature": "SourceStat(label: string, source: string, path: string, note?: string)",
      "description": "One key number from a data source: `source` is a source's id, `path` picks the value in what it returned (`items.length` counts a list, `data.total` reads a field)."
    },
    "SourceTable": {
      "signature": "SourceTable(source: string, rows: string, columns: Col[])",
      "description": "A table of the rows a data source returned. `rows` is the path to the list in what it returned (\"\" when the answer is the list itself); each Col reads one value from a row."
    },
    "SourceList": {
      "signature": "SourceList(source: string, rows: string, title: string, note?: string, heading?: string)",
      "description": "A short list of the items a data source returned: `rows` is the path to the list, `title` the path to each item's text, `note` an optional path to a second line."
    },
    "Check": {
      "signature": "Check(name: string, label: string, value?: $binding<boolean>)",
      "description": "A tick box the person can tick; whether it is ticked is saved on their computer. `name` is its key."
    },
    "Notes": {
      "signature": "Notes(name: string, label: string, placeholder?: string)",
      "description": "A box for the person's own notes; the text is saved on their computer. `name` is its key."
    },
    "Col": {
      "signature": "Col(header: string, path: string)",
      "description": "One column of a SourceTable: its header, and the path to its value in each row."
    },
    "Series": {
      "signature": "Series(name: string, values: number[])",
      "description": "One named set of numbers for a BarChart, one number per label."
    },
    "Task": {
      "signature": "Task(text: string, owner?: string, done?: boolean)",
      "description": "One step or to-do, with who owns it (a person's name) and whether it is done."
    },
    "Option": {
      "signature": "Option(label: string, detail?: string, action?: ActionExpression)",
      "description": "One choice the reader can pick, with a short explanation. Picking it drafts a reply with its label, or with the action's message."
    },
    "Button": {
      "signature": "Button(label: string, action?: ActionExpression, variant?: \"primary\" | \"secondary\")",
      "description": "A button. Without an action, clicking drafts a reply with its label."
    }
  },
  "componentGroups": [
    {
      "name": "Layout",
      "components": [
        "Stack",
        "Card"
      ]
    },
    {
      "name": "Showing information",
      "components": [
        "Text",
        "Stat",
        "Table",
        "BarChart",
        "Series",
        "Checklist",
        "Task",
        "Callout"
      ],
      "notes": [
        "- These show what you write in them. For numbers that come from the person's own services use the data blocks below instead."
      ]
    },
    {
      "name": "Data from the person's connected services",
      "components": [
        "SourceStat",
        "SourceTable",
        "Col",
        "SourceList"
      ],
      "notes": [
        "- Each data block names a source by its id. The panel declares its sources separately (id, server, read-only tool, fixed arguments); never invent a source, a server or a tool.",
        "- `path` is a plain path into what the source returned: names joined by dots, [n] for a list position, `length` for the size of a list. It is not code.",
        "- Write each path from what the tool really returns, as you saw it when you tried the tool. If you did not try it, keep the block simple."
      ]
    },
    {
      "name": "Things the person keeps",
      "components": [
        "Check",
        "Notes",
        "Input",
        "Select"
      ],
      "notes": [
        "- Ticks, notes and field values are saved on the person's computer and are there when they come back. Give each a short, unique `name`."
      ]
    },
    {
      "name": "Drafting a message",
      "components": [
        "Buttons",
        "Button"
      ],
      "notes": [
        "- A button only drafts a message in the person's chat box; they press Send. A panel never changes anything outside Nido by itself."
      ]
    }
  ],
  "actions": {
    "CopyText": {
      "signature": "CopyText(text: string)",
      "description": "Copies the text to the reader's clipboard"
    }
  },
